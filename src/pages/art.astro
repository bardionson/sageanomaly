---
import Layout from '../layouts/Layout.astro';

const artworks = [
  { file: 'SAGEAnomalyUnderNorthBay.gif', title: 'Under North Bay', year: '2022', medium: 'GAN + Oscilloscope' },
  { file: 'alienIntelligence.gif', title: 'Alien Intelligence', year: '2022', medium: 'GAN + CRT' },
  { file: '001_TheAnomalyWatchesWingGlitch-sm.gif', title: 'The Anomaly Watches', year: '2022', medium: 'GAN + Glitch' },
  { file: '002_AnomalyAttacksGlitchOpti.gif', title: 'Anomaly Attacks', year: '2022', medium: 'GAN + CRT Distortion' },
  { file: 'TheHODL-Frame.gif', title: 'The HODL', year: '2022', medium: 'GAN Animation' },
  { file: 'representationOfTheEntityAR.gif', title: 'Entity AR Representation', year: '2022', medium: 'AR + GAN' },
  { file: 'image-9.png', title: 'Entity Probe 9', year: '2022', medium: 'StyleGAN · Pix2Pix' },
  { file: 'image-10.png', title: 'Entity Probe 10', year: '2022', medium: 'StyleGAN · Pix2Pix' },
  { file: 'image-11.png', title: 'Entity Probe 11', year: '2022', medium: 'StyleGAN · Pix2Pix' },
  { file: 'allTiedUp.png', title: 'All Tied Up', year: '2022', medium: 'GAN' },
  { file: 'WreckageOfTheEntitysLatentSpacecraftOilSig.jpg', title: 'Wreckage of the Entity\'s Latent Spacecraft', year: '2022', medium: 'Oil Signature + GAN' },
  { file: 'Anomaly-007.png', title: 'Anomaly 007', year: '2023', medium: 'DCGAN · StyleGAN' },
  { file: 'Anomaly-015.png', title: 'Anomaly 015', year: '2023', medium: 'DCGAN · StyleGAN' },
  { file: 'FutureEastWestTouchSm.jpg', title: 'Future East West Touch', year: '2023', medium: 'GAN' },
  { file: 'ConvergingDistortionsSm.jpg', title: 'Converging Distortions', year: '2023', medium: 'GAN + Oscilloscope' },
  { file: 'fireHeadManFix-g.jpg', title: 'Fire Head', year: '2023', medium: 'GAN' },
  { file: 'promoDropImage.jpg', title: 'Promo Drop', year: '2022', medium: 'GAN' },
  { file: 'tunnelForSage.png', title: 'Tunnel', year: '2022', medium: 'GAN' },
  { file: 'ESDHanscomFieldMass.png', title: 'Hanscom Field Mass', year: '2022', medium: 'GAN + Photography' },
  { file: 'sageComputerDiagram.gif', title: 'SAGE Computer Diagram', year: '2022', medium: 'Animation' },
];
---
<Layout title="THE ART" description="SAGE Anomaly art gallery — AI-generated NFT art by Bård Ionson using GAN, oscilloscopes, CRT, and Pix2Pix">
  <div class="art-header">
    <span class="tag">// ART GALLERY</span>
    <h1>THE ART</h1>
    <p class="desc">
      Created using DCGAN models trained on oscilloscope art, evolved through StyleGAN and Pix2Pix.
      VCRs. CRTs. Lasers. Scanners. The same technologies as SAGE, repurposed to visualize what the Entity left behind.
    </p>
  </div>

  <div class="art-grid">
    {artworks.map((art, i) => (
      <div class="art-card">
        <div class="art-img">
          <img
            src={`/images/${art.file}`}
            alt={art.title}
            loading={i < 6 ? 'eager' : 'lazy'}
          />
        </div>
        <div class="art-info">
          <h3>{art.title}</h3>
          <div class="art-meta">
            <span class="art-year">{art.year}</span>
            <span class="art-medium">{art.medium}</span>
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="collect">
    <div class="collect-head">
      <span class="tag">// COLLECT</span>
      <h2>WHERE TO FIND THE ART</h2>
      <a href="/prints" class="btn-prints">Order Prints →</a>
    </div>

    <div class="collect-group">
      <h3>Tape T Is In The System <span class="live-tag">— current exhibition</span></h3>
      <ul class="link-list">
        <li><a href="https://64xeh9zm.srstudio.dev" target="_blank" rel="noopener">Live gallery on SuperRare Studio ↗</a></li>
      </ul>
    </div>

    <div class="collect-group">
      <h3>Async Blueprints — Anomaly Series</h3>
      <p class="group-note">The generative mint itself: 303 unique pieces from 16 layers, 380,436 possible combinations.</p>
      <ul class="link-list">
        <li><a href="https://opensea.io/item/ethereum/0xc143bbfcdbdbed6d454803804752a064a622c1f3/58252" target="_blank" rel="noopener">Anomaly #094 ↗</a></li>
      </ul>
    </div>

    <div class="collect-group">
      <h3>Async.art — Artificial Entity Probes</h3>
      <ul class="link-list">
        <li><a href="https://async.art/v2/482?referrer=masters" target="_blank" rel="noopener">Artificial Entity Probes (main piece) ↗</a></li>
        <li><a href="https://opensea.io/assets/ethereum/0xb6dae651468e9593e4581705a09c10a76ac1e0c8/483" target="_blank" rel="noopener">Time Space Portals ↗</a></li>
        <li><a href="https://opensea.io/assets/ethereum/0xb6dae651468e9593e4581705a09c10a76ac1e0c8/484" target="_blank" rel="noopener">Human Head Displacement ↗</a></li>
        <li><a href="https://opensea.io/assets/ethereum/0xb6dae651468e9593e4581705a09c10a76ac1e0c8/486" target="_blank" rel="noopener">The Present Place ↗</a></li>
        <li><a href="https://opensea.io/assets/ethereum/0xb6dae651468e9593e4581705a09c10a76ac1e0c8/487" target="_blank" rel="noopener">Mother ↗</a></li>
        <li><a href="https://opensea.io/assets/ethereum/0xb6dae651468e9593e4581705a09c10a76ac1e0c8/488" target="_blank" rel="noopener">Daughter ↗</a></li>
        <li><a href="https://opensea.io/assets/ethereum/0xb6dae651468e9593e4581705a09c10a76ac1e0c8/489" target="_blank" rel="noopener">Ruach HaKodesh ↗</a></li>
        <li><a href="https://opensea.io/assets/ethereum/0xb6dae651468e9593e4581705a09c10a76ac1e0c8/490" target="_blank" rel="noopener">Messages Of The Entity ↗</a></li>
      </ul>
    </div>

    <div class="collect-group">
      <h3>SuperRare</h3>
      <ul class="link-list">
        <li><a href="https://opensea.io/assets/ethereum/0x41a322b28d0ff354040e2cbc676f0320d8c8850d/1023" target="_blank" rel="noopener">Alien Intelligence ↗</a></li>
        <li><a href="https://opensea.io/assets/ethereum/0x41a322b28d0ff354040e2cbc676f0320d8c8850d/1028" target="_blank" rel="noopener">Cosmic Neural Network ↗</a></li>
        <li><a href="https://opensea.io/assets/ethereum/0x41a322b28d0ff354040e2cbc676f0320d8c8850d/1037" target="_blank" rel="noopener">The Entity Meets Homo Sapien ↗</a></li>
        <li><a href="https://opensea.io/assets/ethereum/0x41a322b28d0ff354040e2cbc676f0320d8c8850d/1051" target="_blank" rel="noopener">Representation of the Entity (v.1) ↗</a></li>
        <li><a href="https://opensea.io/assets/ethereum/0x41a322b28d0ff354040e2cbc676f0320d8c8850d/1052" target="_blank" rel="noopener">Representation of the Entity (v.2) ↗</a></li>
        <li><a href="https://opensea.io/assets/ethereum/0x41a322b28d0ff354040e2cbc676f0320d8c8850d/1053" target="_blank" rel="noopener">Representation of the Entity (v.3) ↗</a></li>
        <li><a href="https://opensea.io/assets/ethereum/0x41a322b28d0ff354040e2cbc676f0320d8c8850d/1054" target="_blank" rel="noopener">Representation of the Entity (v.4) ↗</a></li>
        <li><a href="https://opensea.io/assets/ethereum/0x41a322b28d0ff354040e2cbc676f0320d8c8850d/3426" target="_blank" rel="noopener">Representation Of The Entity ↗</a></li>
        <li><a href="https://opensea.io/assets/ethereum/0x41a322b28d0ff354040e2cbc676f0320d8c8850d/1391" target="_blank" rel="noopener">The HODL Frame of North Bay Canada ↗</a></li>
        <li><a href="https://opensea.io/assets/ethereum/0x41a322b28d0ff354040e2cbc676f0320d8c8850d/2477" target="_blank" rel="noopener">Trinity Knot ↗</a></li>
      </ul>
    </div>

    <div class="collect-group">
      <h3>Museum of Crypto Art</h3>
      <ul class="link-list">
        <li><a href="https://app.museumofcryptoart.com/collection/the-permanent-collection?collection=0x41a322b28d0ff354040e2cbc676f0320d8c8850d&token=1054&page=1" target="_blank" rel="noopener">Representation of the Entity (v.4) — permanent collection ↗</a></li>
      </ul>
    </div>

    <p class="collect-footer">
      Also on <a href="https://knownorigin.io" target="_blank" rel="noopener">KnownOrigin</a>.
    </p>
  </div>
</Layout>

<style>
  .art-header {
    padding: 4rem 2rem 3rem;
    border-bottom: 1px solid var(--border);
    max-width: 900px;
  }

  .tag {
    display: block;
    font-size: 0.85rem;
    color: var(--muted);
    letter-spacing: 0.25em;
    margin-bottom: 0.75rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 4rem);
    color: var(--green);
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .desc {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.85;
    max-width: 600px;
  }

  .art-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    margin: 0;
  }

  .art-card {
    background: var(--bg);
    display: flex;
    flex-direction: column;
    transition: background 0.2s;
  }

  .art-card:hover { background: var(--bg2); }

  .art-img {
    overflow: hidden;
    aspect-ratio: 4/3;
  }

  .art-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s;
  }

  .art-card:hover .art-img img { transform: scale(1.03); }

  .art-info {
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--border);
  }

  .art-info h3 {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--text);
    margin-bottom: 0.4rem;
    font-family: var(--font-mono);
    font-weight: normal;
  }

  .art-meta {
    display: flex;
    gap: 1rem;
  }

  .art-year {
    font-size: 0.85rem;
    color: var(--green);
    letter-spacing: 0.1em;
  }

  .art-medium {
    font-size: 0.85rem;
    color: var(--muted);
    letter-spacing: 0.05em;
  }

  .collect {
    padding: 3rem 2rem 4rem;
    border-top: 1px solid var(--border);
    max-width: 900px;
  }

  .collect-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .collect-head h2 {
    font-size: 1.1rem;
    letter-spacing: 0.15em;
    color: var(--green);
    font-family: var(--font-mono);
    font-weight: normal;
  }

  .collect-group {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .collect-group:last-of-type {
    border-bottom: none;
  }

  .collect-group h3 {
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    color: var(--text);
    font-family: var(--font-mono);
    font-weight: normal;
    margin-bottom: 0.5rem;
  }

  .live-tag {
    color: var(--green);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }

  .group-note {
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.5rem 1.5rem;
  }

  .link-list a {
    font-size: 0.85rem;
    color: var(--muted);
    text-decoration: none;
    letter-spacing: 0.02em;
  }

  .link-list a:hover { color: var(--green); }

  .collect-footer {
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 0.5rem;
  }

  .collect-footer a { color: var(--green); text-decoration: none; }

  .btn-prints {
    border: 1px solid var(--green) !important;
    color: var(--green) !important;
    padding: 0.6rem 1.25rem;
    font-size: 0.9rem;
    letter-spacing: 0.15em;
    transition: background 0.2s;
  }

  .btn-prints:hover { background: rgba(0,255,65,0.05); }
</style>
