        </ul>
      </div>

      <div class="dispatch-cta">
        <a href="/story/chapter-one" class="btn-primary">Read Chapter One →</a>
        <a href="/story/the-hypothesis" class="btn-ghost">The SAGE Hypothesis →</a>
